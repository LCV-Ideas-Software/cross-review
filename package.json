    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:public": "prettier --write \"**/index.html\"",
    "format:public:check": "prettier --check \"**/index.html\"",
    "biome": "biome check src scripts",
    "biome:write": "biome check --write src scripts",
    "check": "npm run format:check && npm run lint && npm run biome && npm run typecheck"
